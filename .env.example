# Copy to .env and fill in. NEVER commit .env.

PORT=7100
NODE_ENV=production

# Public https address of this addon (no trailing slash), used to build install links
# and stream URLs. Leave empty to derive it from each request's Host header.
BASE_URL=

# Secret used to encrypt each user's settings (debrid keys etc.) inside their install URL.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If empty the addon creates data/.secret on first start. Changing it invalidates all install URLs.
CONFIG_SECRET=

# Free key from https://www.themoviedb.org/settings/api  ("API Read Access Token", the long one)
TMDB_READ_TOKEN=

# Optional: shared default Torznab (Prowlarr/Jackett) endpoint for torrent releases.
# Users can also enter their own on the configure page.
# Example: http://prowlarr:9696/1/api   (placeholder only)
TORZNAB_URL=
TORZNAB_API_KEY=

# Optional overrides for the Ramadan catalog (YYYY-MM-DD). Otherwise computed from the Islamic calendar.
RAMADAN_2026_START=
RAMADAN_2026_END=

LOG_LEVEL=info
RATE_LIMIT_PER_MINUTE=120

# Set to 1 when running behind a reverse proxy / tunnel (nginx, Cloudflare Tunnel) so rate limiting sees real client IPs.
TRUST_PROXY=0
# Allow users to point the addon at private-network indexers (e.g. http://prowlarr:9696). Only enable on a private instance.
ALLOW_PRIVATE_INDEXERS=false

